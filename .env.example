# Copy to .env and adjust. Every value has a dev default in docker-compose.yml.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
POSTGRES_DB=todo
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
TIME_ZONE=America/Lima

# Real SMTP instead of Mailpit (e.g. Gmail with an app password):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=Todo App <you@gmail.com>
